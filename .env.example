DEEPSEEK_API_KEY=
GITHUB_TOKEN=
ORDER_DB_PASSWORD=

# MySQL 8.4 authoritative store. Host launches of main.py and alembic require
# an explicit INCIDENT_AGENT_DATABASE_URL; there is no default/file fallback.
# Use Python 3.12 with requirements.lock.txt (requirements-test.lock.txt for tests).
# Create the database and a least-privilege account first; keep real passwords
# out of Git. Compose uses its own container database configuration.
# Example: mysql+pymysql://incident_agent:CHANGE_ME@127.0.0.1:3306/incident_agent?charset=utf8mb4
INCIDENT_AGENT_DATABASE_URL=

# Local Web writes default to disabled. JSON array of backend-owned identities:
# [{"actor":"local-operator","token_sha256":"<64 lowercase hex SHA-256>","permissions":["request","approve","execute","knowledge_write"]}]
# Keep remediation permissions ("request", "approve", "execute") separate from "knowledge_write" as needed.
# Supply the actual random token interactively in the Web UI, never as VITE_*.
INCIDENT_AGENT_WEB_OPERATORS=

# Optional knowledge-base embedding backend. Defaults to deterministic local offline hashing
# (provider=offline, model=offline-ngram-v1, dim=256) when left unset.
# Set provider=openai_compatible with explicit base_url, model, dim, and API key to use a remote endpoint.
INCIDENT_AGENT_EMBEDDING_PROVIDER=offline
INCIDENT_AGENT_EMBEDDING_MODEL=offline-ngram-v1
INCIDENT_AGENT_EMBEDDING_DIM=256
INCIDENT_AGENT_EMBEDDING_BASE_URL=
INCIDENT_AGENT_EMBEDDING_API_KEY=
INCIDENT_AGENT_EMBEDDING_TIMEOUT_SECONDS=15
INCIDENT_AGENT_EMBEDDING_SEND_DIMENSIONS=false
