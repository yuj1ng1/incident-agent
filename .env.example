DEEPSEEK_API_KEY=
GITHUB_TOKEN=
ORDER_DB_PASSWORD=

# MySQL 8.4 authoritative store. Create this database and a least-privilege
# account first, then keep the real password out of Git.
# Example: mysql+pymysql://incident_agent:CHANGE_ME@127.0.0.1:3306/incident_agent?charset=utf8mb4
INCIDENT_AGENT_DATABASE_URL=

# Local Web writes default to disabled. JSON array of backend-owned identities:
# [{"actor":"local-operator","token_sha256":"<64 lowercase hex SHA-256>","permissions":["request","approve","execute"]}]
# Supply the actual random token interactively in the Web UI, never as VITE_*.
INCIDENT_AGENT_WEB_OPERATORS=
