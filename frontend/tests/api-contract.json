                "invalid_response",
                "response_too_large",
                "content_encoding_refused",
                "invalid_evidence",
                "lease_expired",
                "alert_changed",
                "configuration_changed",
                "internal_probe_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
